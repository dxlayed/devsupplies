PORT=3000

# Long random strings (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENGINE_SECRET=
WEBHOOK_SECRET=

# Discord OAuth2 (discord.com/developers/applications -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Local testing only: enables fake "Quick Test Sign-in" and simulated payments.
# Leave false (or delete) on the live site.
ALLOW_DEV_LOGIN=false

# Litecoin payments: Electrum-LTC master PUBLIC key (Wallet > Information), starts with zpub
LTC_XPUB=
# Confirmations before a key is issued (1 = about 2.5 minutes)
LTC_CONFIRMATIONS=1
