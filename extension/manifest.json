{
  "manifest_version": 3,
  "name": "Waurks",
  "version": "1.3.1",
  "description": "Sends your pending friend requests to Waurks to detect bots. No cookie access · Only runs on Roblox.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://devsupplies.cc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Waurks",
    "default_popup": "popup.html"
  }
}
