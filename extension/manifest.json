{
  "manifest_version": 3,
  "name": "Waurks",
  "version": "1.0.0",
  "description": "Filters bot friend requests on Roblox. Uses the Roblox login already in your browser.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://devsupplies.cc/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Waurks",
    "default_popup": "popup.html"
  }
}
