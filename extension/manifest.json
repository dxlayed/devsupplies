{
  "manifest_version": 3,
  "name": "Waurks",
  "version": "1.4.0",
  "description": "Sends your pending friend requests to Waurks to detect bots. No cookie access · Only runs on Roblox.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://devsupplies.cc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.roblox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Waurks",
    "default_popup": "popup.html"
  }
}
